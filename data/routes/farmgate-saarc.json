  "provenance": [
    {
      "claim": "Kazi Nazrul Islam Avenue is a trunk dual carriageway (one-way sides of 3-4 lanes, maxspeed 60 where tagged) from Farmgate past Kawran Bazar; corridor Farmgate junction to SAARC mor measures ~1.25 km along the road.",
      "source": "OpenStreetMap way names কাজী নজরুল ইসলাম সরণী/এভিনিউ (Overpass extract 2026-11-04, docs/route-research/)"
    },
    {
      "claim": "Farmgate is a signal-controlled multi-arm junction: Mirpur Road (north and south arms), Kazi Nazrul Islam Avenue (east continuation and west arm), Green Road south, Indira Road toward Tejgaon.",
      "source": "https://en.wikipedia.org/wiki/Farmgate + https://en.wikipedia.org/wiki/Kazi_Nazrul_Islam_Avenue"
    },
    {
      "claim": "The Farmgate footbridge was rebuilt and reopened 15 Oct 2023: ~63 m main span x ~6.4 m wide plus a ~21 m wing toward Holy Cross School, Louis Kahn-inspired tensile canopy, plaza with bus bay under it.",
      "source": "https://www.thedailystar.net/news/bangladesh/news/farmgate-footbridge-reopens-3444541 + /my-dhaka/news/farmgate-footbridge-promoting-pedestrian-safety-and-urban-mobility-3450306"
    },
    {
      "claim": "MRT-6 Farmgate station opened 5 Nov 2023 on the viaduct at the junction; viaduct height is greater at Farmgate, and one portal-frame pillar stands in the carriageway left of the median.",
      "source": "https://en.wikipedia.org/wiki/MRT_Line_6"
    },
    {
      "claim": "Dhaka Elevated Expressway phase 1 (Kawla-Farmgate, opened Sep 2023) runs along the railway through Tejgaon; its ramps land just east of Farmgate (Indira Road), and an FDC-gate exit ramp near Karwan Bazar opened 20 Mar 2024.",
      "source": "https://www.thedailystar.net/news/bangladesh/transport/news/pms-eid-gift-elevated-expressways-fdc-gate-exit-ramp-opened-3570881 + https://en.wikipedia.org/wiki/Dhaka_Elevated_Expressway"
    },
    {
      "claim": "Kawran Bazar wholesale market: DNCC owns four markets (~1,789 permanent + 180 temporary shops); concrete multi-storey kitchen-market building plus tin-shed rows; wholesale runs midnight-7 am; porters carry loads in bamboo tukri baskets.",
      "source": "https://en.wikipedia.org/wiki/Kawran_Bazar + https://www.thedailystar.net/slow-reads/unheard-voices/news/the-invisible-mintis-karwan-bazar-4236886"
    },
    {
      "claim": "The Dhaka trunk railway passes the market's north-east side (Karwan Bazar level crossing is a named choke point); Tejgaon station lies just north; the elevated expressway shadows the rail line.",
      "source": "https://www.thedailystar.net/news/bangladesh/news/dhakas-rail-link-most-country-snapped-students-block-karwan-bazar-level-crossing-3653426"
    },
    {
      "claim": "Verified Kawran Bazar skyline: BDBL Bhaban (18 floors), BSEC Bhaban (RTV HQ), ETV/NTV/ATN studios, TCB Bhaban, Jahangir Tower; a 17th-century three-domed Mughal mosque stands on a raised platform in the market.",
      "source": "https://en.wikipedia.org/wiki/Kawran_Bazar + https://www.thedailystar.net/news/bangladesh/news/karwan-bazars-mughal-era-mosque-echoes-dhakas-rich-past-4024081"
    },
    {
      "claim": "Kawran Bazar metro station opened 31 Dec 2023; its gates carry printed signs banning raw fish, meat and vegetables because shoppers haul produce through the station.",
      "source": "https://www.thedailystar.net/news/bangladesh/transport/news/metro-rail-now-stops-shahbagh-karwan-bazar-stations-3507041"
    },
    {
      "claim": "The SAARC Fountain is a Nitun Kundu welded-steel sculpture (about 9.75 m tall, 32 m pool) on an RCC basin at the Kawran Bazar/Sonargaon crossing in front of Pan Pacific Sonargaon; long neglected, cracked in 2022, typically dry behind tin fencing plastered with posters.",
      "source": "https://en.wikipedia.org/wiki/SAARC_Fountain + https://en.wikipedia.org/wiki/Nitun_Kundu + Bangla Tribune 2022 crack report"
    },
    {
      "claim": "MRT-6 viaduct: median columns with hammerhead caps, precast segmental girders, ~20-25 m pier spacing, 1500 V DC overhead catenary; stations are ~180 m long, three-level, brand green #006747.",
      "source": "https://en.wikipedia.org/wiki/MRT_Line_6 (infobox + station design)"
    },
    {
      "claim": "Vehicles parked on the footpath between Farmgate and the SAARC Fountain force pedestrians onto the road; staff buses park all day along the Karwan Bazar-FDC road.",
      "source": "https://www.thedailystar.net/node/51447 + https://www.thedailystar.net/news/bangladesh/news/illegal-parking-turns-karwan-bazar-nightmare-3822066"
    }
  ],
